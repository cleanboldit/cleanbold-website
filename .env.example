# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=pub-xxxxx.r2.dev,your-custom-domain.com

# Canonical URLs, Open Graph, sitemap, and robots (production domain with https).
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Secret for POST /api/revalidate (header x-revalidate-secret). Optional if you only rely on Payload hooks.
# REVALIDATE_SECRET=your-long-random-string

